{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "book-events-aggregator static events config",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "start"],
        "properties": {
          "title": { "type": "string" },
          "start": { "type": "string", "description": "ISO 8601 local start, e.g. 2027-04-09T10:00:00." },
          "end": { "type": ["string", "null"], "description": "ISO 8601 local end, or null." },
          "location": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "url": { "type": "string" },
          "source": { "type": "string", "description": "Label shown as the event's source." },
          "enabled": { "type": "boolean", "description": "Skip when false. Defaults true." },
          "note": { "type": "string", "description": "Maintenance note; ignored by the crawler." }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
