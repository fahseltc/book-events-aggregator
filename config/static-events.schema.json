{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "book-events-aggregator static events config",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "start"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "ISO 8601 local start, e.g. 2027-04-09T10:00:00."
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 local end, or null."
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Label shown as the event's source."
          },
          "enabled": {
            "type": "boolean",
            "description": "Skip when false. Defaults true."
          },
          "note": {
            "type": "string",
            "description": "Maintenance note; ignored by the crawler."
          }
        },
        "additionalProperties": true
      }
    },
    "recurring": {
      "type": "array",
      "description": "Events that repeat on a rule (e.g. a monthly book club). Expanded into dated occurrences at crawl time.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "when"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "pattern": "^(every\\s+)?(1st|2nd|3rd|4th|5th|first|second|third|fourth|fifth)\\s+[a-zA-Z]+(\\s+of\\s+(the|each)\\s+month)?$",
            "description": "Nth weekday of each month, e.g. \"2nd Wednesday\" or \"every fourth Tuesday\"."
          },
          "time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
            "description": "Local 24-hour start time, e.g. \"19:00\". Omit when unknown; the event is then date-only."
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "monthsAhead": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "description": "How far ahead to generate occurrences. Defaults to 6."
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Individual dates (YYYY-MM-DD) to skip, e.g. a holiday cancellation."
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Label shown as the event's source."
          },
          "enabled": {
            "type": "boolean",
            "description": "Skip when false. Defaults true."
          },
          "note": {
            "type": "string",
            "description": "Maintenance note; ignored by the crawler."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}